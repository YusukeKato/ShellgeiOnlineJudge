# DataBase
POSTGRES_USER=soj_user
POSTGRES_PASSWORD=soj_password
POSTGRES_DB=soj_db
# 管理用と通常実行用は別ユーザー・別passwordにする。既存DBの所有者は変更しない。
# 両URLは必須。ComposeのDBはhost portへ公開せず、管理はmigrate serviceから行う。
MIGRATION_DATABASE_URL=postgresql://soj_user:soj_password@db:5432/soj_db
DATABASE_URL=postgresql://soj_app:soj_app_password@db:5432/soj_db
DATABASE_OPERATION_TIMEOUT_SECONDS=5

# Rootless Docker
# `echo "${XDG_RUNTIME_DIR}/docker.sock"` などで実際のパスを確認する。
DOCKER_SOCKET_PATH=/run/user/1000/docker.sock
# コンテナ内から見たsocketのGID。設定方法はdocs/DEVELOPMENT.mdを参照し、実測値を設定する。
DOCKER_SOCKET_GID=
# deploy/sandbox/Dockerfileでbuild後、docker image inspectで取得したimmutable IDを設定
SANDBOX_IMAGE_ID=
# 同じdaemon上で複数環境を動かす場合は、環境ごとに異なる値を指定する。
SANDBOX_OWNER_ID=shellgei-online-judge

# Backend -> Runner
# `openssl rand -hex 32`で環境ごとに異なる値を生成する。
RUNNER_SHARED_SECRET=replace-with-at-least-32-random-characters

# HTTPS
# 8443はrootless Dockerで利用できる非特権ポート。
HTTPS_BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
TLS_CERTIFICATE_PATH=./deploy/tls/fullchain.pem
TLS_PRIVATE_KEY_PATH=./deploy/tls/privkey.pem

# Backend
SERVER_URL=https://shellgei-online-judge.com
EXECUTION_LOG_RETENTION_DAYS=365
EXECUTION_LOG_MAX_ROWS=10000

# Frontend
VITE_SOJ_URL=${SERVER_URL}
# 公開画面に表示する更新日。製品versionはソースの正本から自動設定する。
VITE_UPDATE_DATE=
VITE_X_URL=https://x.com/yusukekato_main
VITE_GITHUB_REPO_URL=https://github.com/YusukeKato/ShellgeiOnlineJudge
VITE_GITHUB_AUTHOR_URL=https://github.com/YusukeKato
VITE_BLOG_URL=https://yusukekato.jp
VITE_MIXI2_URL=https://mixi.social/communities/dcf8e9d8-a6c4-40a9-8e05-328b4424f886/about
