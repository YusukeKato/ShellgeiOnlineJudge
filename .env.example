# DataBase
POSTGRES_USER=soj_user
POSTGRES_PASSWORD=soj_password
POSTGRES_DB=soj_db
DATABASE_URL=postgresql://soj_user:soj_password@db:5432/soj_db

# Rootless Docker
# `echo "${XDG_RUNTIME_DIR}/docker.sock"` などで実際のパスを確認する。
DOCKER_SOCKET_PATH=/run/user/1000/docker.sock

# Backend -> Runner
# `openssl rand -hex 32`で環境ごとに異なる値を生成する。
RUNNER_SHARED_SECRET=replace-with-at-least-32-random-characters

# HTTPS
# 8443はrootless Dockerで利用できる非特権ポート。
HTTPS_BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
TLS_CERTIFICATE_PATH=./deploy/tls/fullchain.pem
TLS_PRIVATE_KEY_PATH=./deploy/tls/privkey.pem

# Backend
SERVER_URL=https://shellgei-online-judge.com
EXECUTION_LOG_RETENTION_DAYS=365
EXECUTION_LOG_MAX_ROWS=10000

# Frontend
REACT_APP_SOJ_URL=${SERVER_URL}
REACT_APP_UPDATE_DATE=2026/08/16
REACT_APP_VERSION=2.7.3
REACT_APP_X_URL=https://x.com/yusukekato_main
REACT_APP_GITHUB_REPO_URL=https://github.com/YusukeKato/ShellgeiOnlineJudge
REACT_APP_GITHUB_AUTHOR_URL=https://github.com/YusukeKato
REACT_APP_BLOG_URL=https://yusukekato.jp
REACT_APP_MIXI2_URL=https://mixi.social/communities/dcf8e9d8-a6c4-40a9-8e05-328b4424f886/about
